# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated per-client at deploy time
/wrangler.jsonc
/.deploy/
/.wrangler/

# QA suite — generated reports and the image-optimization manifest
/qa-runs/
/qa-verification/
/.image-manifest.json

# Private analysis layer (prompt, exemplars, generation) — its own private repo,
# Chevis-Zhou/aethr-analysis, nested here. This repo is public. Ticket 032.
src/lib/analysis/

# Generated from the shared annotation package; never hand-edit this copy.
/src/lib/edit/shared/
